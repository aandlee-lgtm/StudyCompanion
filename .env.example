# HSC Companion 2027 — copy to .env and fill in. Never commit .env.

# AI provider: "openai" (any OpenAI-compatible API) or "offline" (no AI; deterministic
# Maths marking still works, English/Legal get a clearly labelled heuristic estimate).
HSC_AI_PROVIDER=offline

# OpenAI-compatible settings (OpenAI, Azure OpenAI-compatible gateways, OpenRouter, a local server...)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
HSC_AI_MODEL=gpt-4o

# Where the database, backups and imported PDFs live (default: ./data)
HSC_DATA_DIR=./data

# Server binding. Keep 127.0.0.1 unless you deliberately want LAN/tablet access.
HSC_HOST=127.0.0.1
HSC_PORT=8000
