# HSC Companion 2027 — settings read at startup. Never commit or share a file with real keys.
# Running from source: copy this file to .env in the project folder.
# Installed Mac app: this file lives in ~/Library/Application Support/HSC Companion/.env

# AI provider: "anthropic" (Claude), "openai" (any OpenAI-compatible API) or "offline".
# Offline: Maths and multiple choice are still marked exactly; English and Legal answers are
# self-marked against detailed criteria.
HSC_AI_PROVIDER=offline

# Anthropic (Claude). Default model: claude-opus-5-5
ANTHROPIC_API_KEY=

# OpenAI-compatible (OpenAI, gateways, a local server)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: override the model for the chosen provider (blank = provider default)
HSC_AI_MODEL=

# Where the database, backups and imported PDFs live (default: ./data when running from source)
HSC_DATA_DIR=./data

# Server binding. Keep 127.0.0.1 unless you deliberately want LAN/tablet access; if you change it,
# also list the address you will type in the browser, e.g. HSC_ALLOWED_HOSTS=192.168.1.20
HSC_HOST=127.0.0.1
HSC_PORT=8000
HSC_ALLOWED_HOSTS=
